NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://vuaco:vuaco@localhost:5433/vuaco
REDIS_URL=redis://localhost:6380

# Local dev only: point this at wherever you extracted a Pikafish release
# (see backend/README.md). In Docker, the image sets these for you.
PIKAFISH_BIN_PATH=/opt/pikafish/pikafish
PIKAFISH_CWD=/opt/pikafish
PIKAFISH_POOL_SIZE=2
PIKAFISH_THREADS=1
PIKAFISH_HASH_MB=64
PIKAFISH_DEFAULT_DEPTH=14
PIKAFISH_MAX_DEPTH=24
PIKAFISH_ANALYSIS_TIMEOUT_MS=15000

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOG_PRETTY=true

# Guest auth (see backend/README.md's "Auth" section). CHANGE THIS in any
# shared/deployed environment - this default is an insecure placeholder.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=30d

# Multiplayer rooms
ROOM_PIN_LENGTH=6
ROOM_JOIN_RATE_LIMIT_WINDOW_SECONDS=300
ROOM_JOIN_RATE_LIMIT_MAX=10
CLOCK_TICK_INTERVAL_MS=1000

# Cloud Vision board scan (POST /vision/scan). Leave unset to keep that
# endpoint a 501 stub - see backend/README.md's "Cloud Vision board scan"
# section. Get a key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
VISION_MAX_IMAGE_BYTES=8388608
